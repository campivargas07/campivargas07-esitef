{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-workspaces",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.esitef.com" }],
      "destination": "https://esitef.com/:path*",
      "permanent": true
    }
  ]
}
