# PostgreSQL (target platform)
DATABASE_URL=postgresql://esitef:esitef@localhost:5433/esitef

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Vercel: AUTH_TRUST_HOST=true

# WordPress auth bridge (opcional — desactivar tras cutover)
WP_AUTH_BRIDGE_ENABLED=true
WP_AUTH_BRIDGE_URL=http://localhost:8080/wp-json/esitef/v1/verify-password
WP_AUTH_BRIDGE_SECRET=change-me-in-production

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sesiones online — Google Calendar (disponibilidad Tomás)
# Calendario compartido con la service account (email del JSON).
GOOGLE_CALENDAR_ID=primary
# JSON en una línea: {"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}
GOOGLE_SERVICE_ACCOUNT_JSON=

# En desarrollo sin Google Calendar: checkout simulado (sin Stripe). Forzar: true|false
# SESIONES_ONLINE_SIMULATION=true

# PayPal embebido (USD/MXN/ARS/COP) — SDK v6 en modal de cursos
# Requiere "Advanced Credit and Debit Card Payments" en la app PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Opcional alias del Client ID (mismo valor que arriba)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# Webhook URL: {AUTH_URL}/api/webhooks/paypal
# Diagnóstico: GET {AUTH_URL}/api/checkout/paypal

# Email (confirmación inscripción presencial, contacto, descarga libros). Sin clave = log en servidor.
RESEND_API_KEY=
MAIL_FROM="ESITEF <noreply@esitef.com>"
CONTACT_EMAIL=info@esitef.com
NEWSLETTER_EMAIL=info@esitef.com
LIBRO_LEAD_EMAIL=info@esitef.com
# Aviso interno por compra de formación online (default: CONTACT_EMAIL)
PURCHASES_NOTIFY_EMAIL=info@esitef.com

# Google Sheet — registro automático de compras online (misma service account que Calendar)
# Crear hoja "Compras" con cabecera en fila 1; compartir con client_email de la SA como Editor
GOOGLE_PURCHASES_SHEET_ID=
# GOOGLE_PURCHASES_SHEET_RANGE=Compras!A:I

# Vercel Blob (PDFs de libros — subida desde /admin/libros)
BLOB_READ_WRITE_TOKEN=

# Legacy WP uploads CDN (SiteGround subdomain estático)
NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.esitef.com

# Sentry (errores + performance). Sin DSN = desactivado en runtime.
# Proyecto: esitef / esitef-web
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=esitef
SENTRY_PROJECT=esitef-web
# Solo CI/Vercel para subir source maps
SENTRY_AUTH_TOKEN=

# PostHog (analítica de producto, EU). Sin key = desactivado.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Marketing / campañas (reutiliza IDs de esitef.com/online)
NEXT_PUBLIC_SITE_URL=https://esitef.com
NEXT_PUBLIC_GTM_ID=GTM-NCBZD5KR
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-D0BE47F3N0
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-10943332174
NEXT_PUBLIC_WHATSAPP_NUMBER=5493562435884

# Server-side conversions (generar en GA4 / Meta Business Manager)
GA4_API_SECRET=
META_PIXEL_ID=1545549123277489
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# WordPress MySQL (ETL source — local Docker con dump producción)
WP_MYSQL_HOST=127.0.0.1
WP_MYSQL_PORT=3307
WP_MYSQL_USER=wordpress
WP_MYSQL_PASSWORD=wordpress
WP_MYSQL_DATABASE=wordpress
WP_TABLE_PREFIX=yrc_
